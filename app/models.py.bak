from sqlalchemy import Column, Integer, String, Boolean, ForeignKey, Table
from sqlalchemy.orm import relationship
from .database import Base

# Tabela auxiliar para relacionamento N:N Turma-Professor
turma_professor = Table(
    "turma_professor",
    Base.metadata,
    Column("turma_id", Integer, ForeignKey("turmas.id"), primary_key=True),
    Column("professor_id", Integer, ForeignKey("professores.id"), primary_key=True)
)

class Sala(Base):
    __tablename__ = "salas"

    id = Column(Integer, primary_key=True)
    nome = Column(String, unique=True, nullable=False)
    capacidade = Column(Integer, nullable=False)
    tem_computador = Column(Boolean, default=False)

    # Relação opcional com turmas alocadas
    turmas = relationship("Turma", back_populates="sala")

class Turma(Base):
    __tablename__ = "turmas"

    id = Column(Integer, primary_key=True)
    codigo = Column(String, unique=True, nullable=False)
    carga_horaria = Column(Integer, nullable=False)
    precisa_computador = Column(Boolean, default=False)
    sala_id = Column(Integer, ForeignKey("salas.id"), nullable=True)

    # Relacionamentos
    sala = relationship("Sala", back_populates="turmas")
    professores = relationship("Professor", secondary=turma_professor, back_populates="turmas")
    preferencias = relationship("PreferenciaAluno", back_populates="turma")

class Professor(Base):
    __tablename__ = "professores"

    id = Column(Integer, primary_key=True)
    nome = Column(String, nullable=False)
    disciplinas_aptas = Column(String)  # pode ser CSV ou JSON para simplificar

    turmas = relationship("Turma", secondary=turma_professor, back_populates="professores")

class Aluno(Base):
    __tablename__ = "alunos"

    id = Column(Integer, primary_key=True)
    nome = Column(String, nullable=False)

    preferencias = relationship("PreferenciaAluno", back_populates="aluno")

class PreferenciaAluno(Base):
    __tablename__ = "preferencias_aluno"

    id = Column(Integer, primary_key=True)
    aluno_id = Column(Integer, ForeignKey("alunos.id"), nullable=False)
    turma_id = Column(Integer, ForeignKey("turmas.id"), nullable=False)
    horario_preferido = Column(String, nullable=False)  # ex: M12, T34
    prioridade = Column(Integer, default=1)  # 1=alta prioridade, 2=media, etc.

    aluno = relationship("Aluno", back_populates="preferencias")
    turma = relationship("Turma", back_populates="preferencias")
